<% if (lang==="ru" ) { %>
    <div class="cards projects-cards animated" data-delay="500" id="projects-carousel">
        <div class="card project-card">
            <h3 class="card-title">
                Сайт с викторинами
            </h3>
            <div class="card-content">
                <ul class="project-features-list">
                    <li class="features-list-item">
                        Мой первый опыт использования GitHub Pages
                    </li>
                    <li class="features-list-item">
                        Дизайн был изменён в декабре 2024
                    </li>
                    <li class="features-list-item">
                        Сохранено "историческое" название - test-about-me
                    </li>
                </ul>
            </div>
            <div class="card-links">
                <a href="https://ella-ksenofontova.github.io/test-about-me/" class="card-link">Страница</a> /
                <a href="https://github.com/Ella-Ksenofontova/test-about-me" class="card-link">Репозиторий</a>
            </div>
        </div>
        <div class="card project-card">
            <h3 class="card-title">Цифровой повар</h3>
            <div class="card-content">
                <ul class="project-features-list">
                    <li class="features-list-item">Подбирает блюда на основе предпочтений пользователя</li>
                    <li class="features-list-item">Есть версия на Python (не собираюсь выкладывать)</li>
                </ul>
            </div>
            <div class="card-links">
                <a href="https://ella-ksenofontova.github.io/digital-cook-web/" class="card-link">Страница</a> /
                <a href="https://github.com/Ella-Ksenofontova/digital-cook-web" class="card-link">Репозиторий</a>
            </div>
        </div>
        <div class="card project-card">
            <h3 class="card-title">Сайт о стилях в дизайне интерьеров</h3>
            <div class="card-content">
                <ul class="project-features-list">
                    <li class="features-list-item">Первый проект на React</li>
                    <li class="features-list-item">Раньше использовал СУБД Firestore от Google</li>
                </ul>
            </div>
            <div class="card-links">
                <a href="https://ella-ksenofontova.github.io/interior-design-styles/" class="card-link">Страница</a> /
                <a href="https://github.com/Ella-Ksenofontova/interior-design-styles" class="card-link">Репозиторий</a>
            </div>
        </div>
        <div class="card project-card">
            <h3 class="card-title">Блог о моде и стиле</h3>
            <div class="card-content">
                <ul class="project-features-list">
                    <li class="features-list-item">Использует Bootstrap и Jekyll</li>
                    <li class="features-list-item">Не наполняется с лета 2025 года</li>
                </ul>
            </div>
            <div class="card-links">
                <a href="https://ella-ksenofontova.github.io/fashion-encyclopedia/" class="card-link">Страница</a> /
                <a href="https://github.com/Ella-Ksenofontova/fashion-encyclopedia" class="card-link">Репозиторий</a>
            </div>
        </div>
    </div>
    <div class="buttons-panel animated" data-delay="750">
        <button id="projects-prev" class="prev-button">
            <% if (isCute ) { %>
                <img src="/assets/cute-chevron.png" alt="Предыдущая карточка" height="20" width="20">
                <% } else { %>
                    <img src="/assets/prev-next.png" alt="Предыдущая карточка" height="20" width="20">
                    <% } %>
        </button>
        <button id="projects-next" class="next-button">
            <% if (isCute ) { %>
                <img src="/assets/cute-chevron.png" alt="Следующая карточка" height="20" width="20">
                <% } else { %>
                    <img src="/assets/prev-next.png" alt="Следующая карточка" height="20" width="20">
                    <% } %>
        </button>
    </div>
    <% } else { %>

        <div class="cards projects-cards animated" data-delay="500" id="projects-carousel">
            <div class="card project-card">
                <h3 class="card-title">
                    Website with quizes
                </h3>
                <div class="card-content">
                    <ul class="project-features-list">
                        <li class="features-list-item">
                            My first experience with GitHub Pages
                        </li>
                        <li class="features-list-item">
                            In December 2024, the design has been updated
                        </li>
                        <li class="features-list-item">
                            The website bears the "historical" name - <em>test-about-me</em>
                        </li>
                    </ul>
                </div>
                <div class="card-links">
                    <a href="https://ella-ksenofontova.github.io/test-about-me/" class="card-link">Page</a> /
                    <a href="https://github.com/Ella-Ksenofontova/test-about-me" class="card-link">Repository</a>
                </div>
            </div>
            <div class="card project-card">
                <h3 class="card-title">Digital cook</h3>
                <div class="card-content">
                    <ul class="project-features-list">
                        <li class="features-list-item">Finds dishes that match user's preferences</li>
                        <li class="features-list-item">There is Python-based version, but I'm not going to publish it
                        </li>
                    </ul>
                </div>
                <div class="card-links">
                    <a href="https://ella-ksenofontova.github.io/digital-cook-web/" class="card-link">Page</a> /
                    <a href="https://github.com/Ella-Ksenofontova/digital-cook-web" class="card-link">Repository</a>
                </div>
            </div>
            <div class="card project-card">
                <h3 class="card-title">Website about interior design styles</h3>
                <div class="card-content">
                    <ul class="project-features-list">
                        <li class="features-list-item">First project created with React</li>
                        <li class="features-list-item">In the past, it used Firestore from Google</li>
                    </ul>
                </div>
                <div class="card-links">
                    <a href="https://ella-ksenofontova.github.io/interior-design-styles/" class="card-link">Page</a>
                    /
                    <a href="https://github.com/Ella-Ksenofontova/interior-design-styles"
                        class="card-link">Repository</a>
                </div>
            </div>
            <div class="card project-card">
                <h3 class="card-title">Fashion Encyclopedia (blog about fashion and style)</h3>
                <div class="card-content">
                    <ul class="project-features-list">
                        <li class="features-list-item">Uses Bootstrap and Jekyll</li>
                        <li class="features-list-item">Hasn't been updated since summer 2025</li>
                    </ul>
                </div>
                <div class="card-links">
                    <a href="https://ella-ksenofontova.github.io/fashion-encyclopedia/" class="card-link">Page</a> /
                    <a href="https://github.com/Ella-Ksenofontova/fashion-encyclopedia" class="card-link">Repository</a>
                </div>
            </div>
        </div>
        <div class="buttons-panel animated" data-delay="750">
            <button id="projects-prev" class="prev-button">
                <% if (isCute ) { %>
                    <img src="/assets/cute-chevron.png" alt="Previous card" height="20" width="20">
                    <% } else { %>
                        <img src="/assets/prev-next.png" alt="Previous card" height="20" width="20">
                        <% } %>
            </button>
            <button id="projects-next" class="next-button">
                <% if (isCute ) { %>
                    <img src="/assets/cute-chevron.png" alt="Next card" height="20" width="20">
                    <% } else { %>
                <img src="/assets/prev-next.png" alt="Next card" height="20" width="20">
                <% } %>
            </button>
        </div>
        <% } %>