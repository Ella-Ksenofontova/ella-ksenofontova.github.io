<div class="cards about-me-cards">
  <div class="card animated" data-delay="500">
    <% if(lang==="ru" ) { %>
      <h3 class="card-title">⌛ Возраст</h3>
      <div class="card-content">18 лет</div>
      <% } else { %>
        <h3 class="card-title">⌛ Age</h3>
        <div class="card-content">18 years</div>
        <% } %>
  </div>
  <div class="card animated" data-delay="750">
    <% if(lang==="ru" ) { %>
      <h3 class="card-title">📍 Где живу</h3>
      <div class="card-content">В Москве</div>
      <% } else { %>
        <h3 class="card-title">📍 Place of living</h3>
        <div class="card-content">Moscow</div>
        <% } %>
  </div>
  <div class="card animated" data-delay="1000">
    <% if(lang==="ru" ) { %>
      <h3 class="card-title">👩‍💻 Кем хочу стать</h3>
      <div class="card-content">Fullstack-разработчиком</div>
      <% } else { %>
        <h3 class="card-title">👩‍💻 Dream job</h3>
        <div class="card-content">Fullstack developer</div>
        <% } %>
  </div>
  <div class="card animated" data-delay="1250">
    <% if(lang==="ru" ) { %>
      <h3 class="card-title">🎓 Где учусь</h3>
      <div class="card-content">РТУ МИРЭА (2 курс)</div>
      <% } else { %>
        <h3 class="card-title">🎓 Education</h3>
        <div class="card-content">RTU MIREA (sophomore)</div>
        <% } %>
  </div>
</div>