<div class="cards i-love-cards">
    <div class="card i-love-card animated" data-delay="500">
        <% if(lang==="ru" ) { %>
            <img src="/assets/Эша.jpg" alt="Мой кот, Эшампле" class="card-image">
            <h3 class="card-title">Котиков</h3>
            <% } else { %>
                <img src="/assets/Эша.jpg" alt="Eixample, my cat" class="card-image">
                <h3 class="card-title">Cats</h3>
                <% } %>
    </div>
    <div class="card i-love-card animated" data-delay="750">
        <img src="/assets/draw-card.jpg" alt="" class="card-image">
        <% if(lang==="ru" ) { %>
            <h3 class="card-title">Рисовать</h3>
            <% } else { %>
                <h3 class="card-title">Drawing</h3>
                <% } %>
    </div>
    <div class="card i-love-card animated" data-delay="1000">
        <img src="/assets/pizza.jpg" alt="" class="card-image">
        <% if(lang==="ru" ) { %>
            <h3 class="card-title">Вкусно поесть</h3>
            <% } else { %>
                <h3 class="card-title">Tasty food</h3>
                <% } %>
    </div>
    <div class="card i-love-card animated" data-delay="1250">
        <% if(lang==="ru" ) { %>
            <img src="/assets/love nikki.webp" alt="Love Nikki, одна из одевалок, в которые я играю" class="card-image">
            <h3 class="card-title">Игры-одевалки</h3>
            <% } else { %>
                <img src="/assets/love nikki.webp" alt="Love Nikki, one of dress-up games I play"
                    class="card-image">
                <h3 class="card-title">Dress-up games</h3>
                <% } %>
    </div>
    <div class="card i-love-card animated" data-delay="1500">
        <img src="/assets/микрофон.jpg" alt="" class="card-image">
        <% if(lang==="ru" ) { %>
            <h3 class="card-title">Переводить песни</h3>
            <% } else { %>
                <h3 class="card-title">Translatig songs</h3>
                <% } %>
    </div>
</div>